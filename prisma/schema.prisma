// GharHop prototype data model
// Simplified from the full PRD canonical model, but keeps the load-bearing
// mechanics: freshness TTL, atomic slot holds, visit state machine, outcomes.

generator client {
  provider = "prisma-client-js"
}

// Local SQLite file for the prototype — no server/credentials to configure.
// Swap to PostgreSQL/PostGIS per the technical blueprint when moving past the prototype.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  SEEKER
  OWNER
  ADMIN
}

enum InventoryType {
  FLAT
  ROOM
  PG_BED
}

// Matches the PRD's own listing lifecycle (section 9): a DRAFT owner submits
// goes to PENDING_VERIFICATION, an admin approves (-> ACTIVE) or rejects
// (-> REJECTED, with a reason, editable and resubmittable).
enum ListingStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  RENTED
  REJECTED
}

enum SlotStatus {
  OPEN
  HELD
  BOOKED
  BLOCKED
  CANCELLED
}

enum HoldStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
}

enum InterestAction {
  SHORTLIST
  PASS
}

enum VisitStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED_BY_SEEKER
  CANCELLED_BY_HOST
  NO_SHOW_SEEKER
  NO_SHOW_HOST
  EXPIRED
}

enum BookingMode {
  INSTANT
  APPROVAL
}

enum VisitOutcome {
  PASS
  MAYBE
  SHORTLIST
  OFFER
  COULD_NOT_VISIT
}

enum ReportStatus {
  OPEN
  TRIAGED
  ACTIONED
  NO_VIOLATION
  CLOSED
}

// --- Monetization (business-plan Phase 1 slice: rolling visit-access
// model + Rush Credit + MoveNow passes + owner FastFill/Success plans) ---
// Payments are mocked the same way auth is mocked (see lib/auth.ts) — no
// real gateway integration, but every balance change is still recorded as
// a ledger entry rather than a bare counter, per the business plan's own
// "never update only a numerical balance" rule.

enum SubscriptionPlan {
  MOVE_NOW_PASS
  MOVE_NOW_PLUS
  CONCIERGE
  OWNER_FASTFILL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)
  startAt   DateTime           @default(now())
  endAt     DateTime
  priceInr  Int
  createdAt DateTime           @default(now())

  orders Order[]
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  // Spendable Rush Credits and credits currently held against a pending
  // priority request — kept as fast-read columns, always updated in the
  // same transaction as the ledger entry below that explains the change.
  balance   Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  entries CreditLedgerEntry[]
}

enum CreditLedgerType {
  GRANTED
  PURCHASED
  RESERVED
  CONSUMED
  RESTORED
  EXPIRED
  REFUNDED
}

model CreditLedgerEntry {
  id        String           @id @default(cuid())
  walletId  String
  wallet    CreditWallet     @relation(fields: [walletId], references: [id])
  type      CreditLedgerType
  amount    Int
  reason    String?
  holdId    String?
  visitId   String?
  createdAt DateTime         @default(now())
}

enum OrderType {
  RUSH_CREDIT_PACK
  MOVE_NOW_PASS
  MOVE_NOW_PLUS
  CONCIERGE
  OWNER_FASTFILL
  OWNER_SPONSORED_VISIT
  OWNER_VERIFIED_MOVE_IN_FEE
}

enum OrderStatus {
  SUCCEEDED
  REFUNDED
  FAILED
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  type           OrderType
  amountInr      Int
  status         OrderStatus   @default(SUCCEEDED)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  visitId        String?
  metadata       String?
  createdAt      DateTime      @default(now())
}

model User {
  id               String   @id @default(cuid())
  phone            String   @unique
  name             String
  role             Role
  reliabilityScore Int      @default(100)
  createdAt        DateTime @default(now())

  properties     Property[]      @relation("OwnerProperties")
  interests      Interest[]
  visitsAsSeeker Visit[]         @relation("SeekerVisits")
  reportsFiled   TrustReport[]   @relation("Reporter")
  notifications  Notification[]
  wallet         CreditWallet?
  subscriptions  Subscription[]
  orders         Order[]
}

model Property {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("OwnerProperties", fields: [ownerId], references: [id])
  title     String
  area      String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  items InventoryItem[]
}

model InventoryItem {
  id                String        @id @default(cuid())
  propertyId        String
  property          Property      @relation(fields: [propertyId], references: [id])
  type              InventoryType
  configuration     String
  rentAmount        Int
  depositAmount     Int
  furnishing        String
  occupancyPolicy   String?
  availableFrom     DateTime
  status            ListingStatus @default(DRAFT)
  bookingMode       BookingMode   @default(INSTANT)
  lastConfirmedAt   DateTime      @default(now())
  freshnessTtlHours Int           @default(72)
  // JSON-encoded string[] of photo paths — /photos/*.jpg demo assets until an
  // owner uploads real ones under /uploads/<itemId>/*, see src/lib/photos.ts
  // and src/app/api/items/[id]/photos/route.ts. No media provenance/
  // verification pipeline (PRD GH-404 is P1).
  photos            String        @default("[]")
  rejectionReason   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Owner-sponsored premium visits (business plan section 9): when true,
  // a seeker can book this item's within-the-week slots for free; GharHop
  // charges the owner only once they actually confirm the resulting visit.
  sponsoredVisitEnabled Boolean   @default(false)
  // Set once a completed tenancy on this unit is verified (business plan
  // section 4 "verifying a move-in") — triggers the owner's move-in fee
  // unless they hold an active FastFill subscription.
  moveInVerifiedAt      DateTime?

  slots     AvailabilitySlot[]
  interests Interest[]
  visits    Visit[]
  rooms     Room[]
}

// Room-organized photos for the Room Tour ("Living Room", "Bedroom", ...) —
// distinct from InventoryItem.photos, which is just the swipe-card cover set.
model Room {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  name            String
  displayOrder    Int           @default(0)
  createdAt       DateTime      @default(now())

  photos RoomPhoto[]
}

model RoomPhoto {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id])
  url          String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model AvailabilitySlot {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  startTime       DateTime
  endTime         DateTime
  capacity        Int           @default(1)
  bookedCount     Int           @default(0)
  status          SlotStatus    @default(OPEN)
  createdAt       DateTime      @default(now())

  holds SlotHold[]
  visit Visit?
}

model SlotHold {
  id             String     @id @default(cuid())
  slotId         String
  slot           AvailabilitySlot @relation(fields: [slotId], references: [id])
  seekerId       String
  idempotencyKey String     @unique
  expiresAt      DateTime
  status         HoldStatus @default(ACTIVE)
  // True when this hold consumed a Rush Credit reservation to get priority
  // access to a within-the-week slot — tracked here so the credit can be
  // restored/consumed correctly once the hold resolves (see lib/billing.ts).
  creditReserved Boolean    @default(false)
  // True when this hold used the listing's owner-sponsored-visit offer
  // instead of a Rush Credit — carried onto the Visit at confirm time.
  sponsoredByOwner Boolean  @default(false)
  createdAt      DateTime   @default(now())
}

model Interest {
  id              String         @id @default(cuid())
  seekerId        String
  seeker          User           @relation(fields: [seekerId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  action          InterestAction
  moveInDate      DateTime?
  budgetMax       Int?
  createdAt       DateTime       @default(now())

  @@unique([seekerId, inventoryItemId])
}

model Visit {
  id              String        @id @default(cuid())
  slotId          String        @unique
  slot            AvailabilitySlot @relation(fields: [slotId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  seekerId        String
  seeker          User          @relation("SeekerVisits", fields: [seekerId], references: [id])
  status          VisitStatus   @default(REQUESTED)
  bookingMode     BookingMode   @default(INSTANT)
  scheduledStart  DateTime
  scheduledEnd    DateTime
  checkedInAt     DateTime?
  completedAt     DateTime?
  cancelReason    String?
  outcome         VisitOutcome?
  outcomeNote     String?
  // true when the *owner* proposed this slot/time as a counter-offer and is
  // now waiting on the seeker to accept/decline it (PRD "counter-proposal"
  // booking mode) — same REQUESTED status, opposite direction of who's waiting.
  proposedByOwner Boolean       @default(false)
  // Carried over from SlotHold.creditReserved at confirmation time — lets
  // cancel/no-show/complete settle the Rush Credit ledger correctly.
  creditReserved  Boolean       @default(false)
  // True when this visit used the owner's sponsored-visit offer instead of
  // the seeker's own credit/subscription — charged to the owner on accept.
  sponsoredByOwner Boolean      @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TrustReport {
  id         String       @id @default(cuid())
  category   String
  targetType String
  targetId   String
  reporterId String?
  reporter   User?        @relation("Reporter", fields: [reporterId], references: [id])
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}
